{
  "name": "auto-product-video-generator-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "apvg": "task dev:cli --",
    "build": "task build",
    "build:watch": "task build:watch",
    "clean": "task clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint packages/*/src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:set": "tsx scripts/set-version.ts",
    "release:check": "task release:check",
    "publish:npm": "task publish:npm",
    "setup": "task install",
    "setup:full": "task install PROFILE=local WITH_OLLAMA=true",
    "setup:cloud-only": "task install PROFILE=local WITH_OLLAMA=false",
    "setup:ci": "task install PROFILE=ci WITH_OLLAMA=true",
    "serve": "task serve",
    "serve:stop": "task stop",
    "doctor": "task doctor",
    "task": "task"
  },
  "dependencies": {
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@go-task/cli": "^3.52.0",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "esbuild": "^0.28.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "js-yaml": "^4.1.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
