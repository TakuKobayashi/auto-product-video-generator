{
  "name": "auto-product-video-generator",
  "version": "0.1.0",
  "description": "AI-powered promotional video generator for web apps and CLI tools",
  "type": "module",
  "bin": {
    "apvg": "./bin/apvg.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "bin/",
    "dist/",
    "README.md"
  ],
  "repository": { "type": "git", "url": "git+https://github.com/TakuKobayashi/auto-product-video-generator.git", "directory": "packages/cli" },
  "homepage": "https://github.com/TakuKobayashi/auto-product-video-generator#readme",
  "bugs": { "url": "https://github.com/TakuKobayashi/auto-product-video-generator/issues" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@auto-product-video-generator/ai": "workspace:*",
    "@auto-product-video-generator/core": "workspace:*",
    "@auto-product-video-generator/playwright": "workspace:*",
    "@auto-product-video-generator/recorder": "workspace:*",
    "@auto-product-video-generator/renderer": "workspace:*",
    "@auto-product-video-generator/source": "workspace:*",
    "@auto-product-video-generator/voicevox": "workspace:*",
    "commander": "^12.1.0"
  },
  "keywords": [
    "demo",
    "video",
    "ai",
    "playwright",
    "ffmpeg",
    "voicevox",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
